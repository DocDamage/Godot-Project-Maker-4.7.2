            "type": "object",
            "properties": {
              "next_source_id": {
                "type": "integer",
                "minimum": 0
              },
              "retired": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "next_source_id",
              "retired"
            ]
          }
        },
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tilesets",
        "entities"
      ]
    },
    "FolderRule": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "glob": {
          "type": "string"
        },
        "set": {
          "$ref": "#/$defs/FacetsPartial"
        }
      },
      "additionalProperties": false,
      "required": [
        "pack_id",
        "glob",
        "set"
      ]
    },
    "FacetsPartial": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "GROUND",
            "WALL",
            "CLIFF",
            "WATER",
            "ROAD",
            "AUTOTILE",
            "DECORATION",
            "BUILDING",
