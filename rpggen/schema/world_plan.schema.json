{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rpggen world plan",
  "type": "object",
  "properties": {
    "world_plan_version": {"const": 1},
    "seed": {"type": "integer"},
    "areas": {
      "type": "array",
      "items": {"$ref": "#/$defs/Area"}
    },
    "rooms": {"$ref": "#/$defs/Rooms"},
    "stages": {"$ref": "#/$defs/Stages"},
    "farm": {"$ref": "#/$defs/Farm"},
    "grid": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Cell"}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "key": {
      "type": "object",
      "properties": {
        "item": {"type": "string"},
        "area": {"type": "string"},
        "opens": {"type": "string"},
        "chest": {"type": "string"}
      },
      "required": ["item", "area", "opens"],
      "additionalProperties": false
    },
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {"map_hash": {"type": "string"}},
        "required": ["map_hash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["world_plan_version", "seed", "areas", "grid", "notes", "maps"],
  "additionalProperties": false,
  "$defs": {
    "Farm": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "crops": {"type": "array", "items": {"$ref": "#/$defs/Crop"}},
        "map": {"$ref": "#/$defs/FarmMap"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["plan_version", "seed", "difficulty", "crops", "notes"],
      "additionalProperties": false
    },
    "FarmMap": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "map": {"type": "string", "minLength": 1},
        "farm_size": {"enum": ["small", "medium", "large"]},
        "plot": {"enum": ["small", "medium", "large"]},
        "animals": {"enum": ["none", "coop", "coop_and_barn"]},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "size": {"$ref": "#/$defs/Cell"},
        "house": {"$ref": "#/$defs/FarmBuilding"},
        "bin": {
          "type": "object",
          "properties": {"cell": {"$ref": "#/$defs/Cell"}, "front": {"$ref": "#/$defs/Cell"}},
          "required": ["cell"],
          "additionalProperties": false
        },
        "tillable": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "water": {
          "type": "object",
          "properties": {
            "kind": {"enum": ["pond", "well"]},
            "cells": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
            "fill": {"$ref": "#/$defs/Cell"}
          },
          "required": ["kind", "cells"],
          "additionalProperties": false
        },
        "animal_houses": {"type": "array", "items": {"$ref": "#/$defs/FarmBuilding"}},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "debris": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["branch", "stump", "grass"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "trees": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "scenery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["bush", "rock", "flowers"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "exit": {
          "type": "object",
          "properties": {
            "edge": {"enum": ["N", "E", "S", "W"]},
            "cell": {"$ref": "#/$defs/Cell"},
            "spawn": {"$ref": "#/$defs/Cell"},
            "facing": {"enum": ["up", "down", "left", "right"]},
            "to": {"type": "string"}
          },
          "required": ["edge", "cell", "spawn", "facing", "to"],
          "additionalProperties": false
        },
        "start": {
          "type": "object",
          "properties": {
            "map": {"type": "string"},
            "cell": {"$ref": "#/$defs/Cell"},
            "facing": {"enum": ["up", "down", "left", "right"]}
          },
          "required": ["map", "cell", "facing"],
          "additionalProperties": false
        },
        "added_maps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "plan_version", "seed", "id", "map", "farm_size", "plot", "animals", "difficulty", "size",
        "house", "bin", "tillable", "water", "animal_houses", "paths", "debris", "trees",
        "scenery", "exit", "start", "added_maps", "notes"
      ],
      "additionalProperties": false
    },
    "FarmBuilding": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "kind": {"enum": ["house", "coop", "barn"]},
        "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        "door": {"$ref": "#/$defs/Cell"},
        "interior": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "size": {"$ref": "#/$defs/Cell"},
            "door": {"$ref": "#/$defs/Cell"},
            "arrive": {"$ref": "#/$defs/Cell"},
            "bed": {
              "type": "object",
              "properties": {"cell": {"$ref": "#/$defs/Cell"}, "size": {"$ref": "#/$defs/Cell"}},
              "required": ["cell", "size"],
              "additionalProperties": false
            },
            "start": {"$ref": "#/$defs/Cell"},
            "trough": {"$ref": "#/$defs/Cell"},
            "stalls": {"type": "array", "items": {"$ref": "#/$defs/Cell"}}
          },
          "required": ["id", "size", "door", "arrive"],
          "additionalProperties": false
        },
        "yard": {
          "type": "object",
          "properties": {
            "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
            "fence": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
            "gate": {"$ref": "#/$defs/Cell"},
            "side": {"enum": ["N", "E", "S", "W"]}
          },
          "required": ["rect", "fence"],
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "rect", "door", "interior"],
      "additionalProperties": false
    },
    "Crop": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": "string"},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "seed": {"type": "string", "minLength": 1},
        "produce": {"type": "string", "minLength": 1},
        "seasons": {
          "type": "array",
          "items": {"enum": ["spring", "summer", "autumn", "winter"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "days": {"type": "integer", "minimum": 1},
        "stages": {"type": "integer", "minimum": 1},
        "regrow": {"type": "integer", "minimum": 0},
        "seed_price": {"type": "integer", "minimum": 0},
        "price": {"type": "integer", "minimum": 0},
        "energy": {"type": "integer", "minimum": 0},
        "yield": {"type": "integer", "minimum": 1}
      },
      "required": [
        "id", "name", "seed", "produce", "seasons", "days", "stages", "regrow", "seed_price",
        "price", "energy"
      ],
      "additionalProperties": false
    },
    "Stages": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "kind": {"enum": ["shmup", "run_and_gun", "racing"]},
        "chunk_cols": {"type": "integer", "minimum": 1},
        "track_size": {"enum": ["small", "medium", "large"]},
        "laps": {"type": "integer", "minimum": 1},
        "block": {"type": "integer", "minimum": 1},
        "road": {"type": "integer", "minimum": 1},
        "grapple": {"type": "boolean"},
        "jump": {"type": "boolean"},
        "rows": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "orientation": {"enum": ["vertical", "horizontal"]},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "length": {"enum": ["short", "medium", "long"]},
        "view": {"$ref": "#/$defs/Cell"},
        "tile": {"type": "integer", "minimum": 8},
        "added": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "scene": {"type": "string"},
              "title": {"type": "string"},
              "level": {"type": "integer", "minimum": 0},
              "axis": {"enum": ["up", "right", "none"]},
              "speed": {"type": "number"},
              "length": {"type": "number", "minimum": 0},
              "exit": {"enum": ["reach_end", "clear_waves", "custom"]},
              "par_time_s": {"type": "number"},
              "waves": {"type": "array", "items": {"type": "object", "required": ["id", "enemy", "at"]}},
              "boss": {"type": "object"}
            },
            "required": ["id", "scene", "axis", "speed", "length", "exit", "waves"]
          }
        }
      },
      "required": ["plan_version", "orientation", "difficulty", "view", "tile", "list"],
      "additionalProperties": false
    },
    "Rooms": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
        "room_size": {"$ref": "#/$defs/Cell"},
        "abilities": {"type": "array", "items": {"type": "string"}},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "guardian": {"type": "string"},
        "path": {"type": "array", "items": {"type": "string"}},
        "list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Room"}}
      },
      "required": ["version", "room_size", "abilities", "start", "end", "list"],
      "additionalProperties": false
    },
    "Room": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^room_[a-z0-9_]+$"},
        "name": {"type": "string"},
        "kind": {"enum": ["start", "corridor", "shaft", "guardian", "pickup", "end"]},
        "map": {"type": "string"},
        "cell": {"$ref": "#/$defs/Cell"},
        "size": {"$ref": "#/$defs/Cell"},
        "added": {"type": "boolean"},
        "tiles": {"type": "array", "items": {"type": "string", "pattern": "^[#.=HT^B]+$"}},
        "exits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "edge": {"enum": ["N", "E", "S", "W"]},
              "cell": {"$ref": "#/$defs/Cell"},
              "to": {"type": "string"},
              "to_exit": {"type": "string"},
              "needs": {"type": "string"}
            },
            "required": ["id", "edge", "cell", "to", "to_exit"],
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ability": {"type": "string"},
              "kind": {"enum": ["ledge", "gap", "wall", "shaft"]},
              "size": {"type": "integer"},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["ability", "kind", "size", "cell"],
            "additionalProperties": false
          }
        },
        "enemies": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "spawn": {"$ref": "#/$defs/Cell"},
        "sign": {"$ref": "#/$defs/Cell"},
        "station": {"$ref": "#/$defs/Cell"},
        "npc": {"$ref": "#/$defs/Cell"},
        "chest": {"$ref": "#/$defs/Cell"},
        "pickup": {
          "type": "object",
          "properties": {"ability": {"type": "string"}, "cell": {"$ref": "#/$defs/Cell"}},
          "required": ["ability", "cell"],
          "additionalProperties": false
        },
        "guardian": {
          "type": "object",
          "properties": {"cell": {"$ref": "#/$defs/Cell"}, "grants": {"type": "string"}},
          "required": ["cell", "grants"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "kind", "map", "cell", "size", "tiles", "exits"],
      "additionalProperties": false
    },
    "Cell": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2
    },
    "Door": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "edge": {"enum": ["N", "E", "S", "W"]},
        "cell": {"$ref": "#/$defs/Cell"},
        "spawn": {"$ref": "#/$defs/Cell"},
        "spawn_id": {"type": "string"},
        "facing": {"enum": ["up", "down", "left", "right"]},
        "to": {"type": "string"},
        "to_map": {"type": "string"},
        "to_spawn": {"type": "string"},
        "key": {"type": "string"}
      },
      "required": ["id", "edge", "cell", "spawn", "spawn_id", "facing", "to", "to_map", "to_spawn"],
      "additionalProperties": false
    },
    "Area": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string"},
        "biome": {"enum": ["village", "field", "forest", "cave", "shore"]},
        "wanted_biome": {"enum": ["village", "field", "forest", "cave", "shore"]},
        "size": {"$ref": "#/$defs/Cell"},
        "map": {"type": "string"},
        "ground": {"type": "string"},
        "doors": {"type": "array", "items": {"$ref": "#/$defs/Door"}},
        "chests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "cell": {"$ref": "#/$defs/Cell"},
              "gold": {"type": "integer", "minimum": 0},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "item_id": {"type": "string"},
                    "qty": {"type": "integer", "minimum": 1}
                  },
                  "required": ["item_id", "qty"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "cell", "gold", "items"],
            "additionalProperties": false
          }
        },
        "enemies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"type": "string"}, "cell": {"$ref": "#/$defs/Cell"}},
            "required": ["id", "cell"],
            "additionalProperties": false
          }
        },
        "decorations": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "decor_words": {"type": "array", "items": {"type": "string"}},
        "water": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 4,
          "maxItems": 4
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "cell": {"$ref": "#/$defs/Cell"},
              "key_item": {"type": "string"},
              "door": {"type": "string"}
            },
            "required": ["id", "cell", "key_item", "door"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "name", "biome", "size", "map", "ground", "doors"],
      "additionalProperties": false
    }
  }
}
