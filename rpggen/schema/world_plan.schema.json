{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rpggen world plan",
  "type": "object",
  "properties": {
    "world_plan_version": {"const": 1},
    "seed": {"type": "integer"},
    "areas": {
      "type": "array",
      "items": {"$ref": "#/$defs/Area"}
    },
    "rooms": {"$ref": "#/$defs/Rooms"},
    "stages": {"$ref": "#/$defs/Stages"},
    "farm": {"$ref": "#/$defs/Farm"},
    "grid": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Cell"}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "key": {
      "type": "object",
      "properties": {
        "item": {"type": "string"},
        "area": {"type": "string"},
        "opens": {"type": "string"},
        "chest": {"type": "string"}
      },
      "required": ["item", "area", "opens"],
      "additionalProperties": false
    },
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {"map_hash": {"type": "string"}},
        "required": ["map_hash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["world_plan_version", "seed", "areas", "grid", "notes", "maps"],
  "additionalProperties": false,
  "$defs": {
    "Farm": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "crops": {"type": "array", "items": {"$ref": "#/$defs/Crop"}},
        "map": {"$ref": "#/$defs/FarmMap"},
        "people": {"type": "array", "items": {"$ref": "#/$defs/Person"}},
        "animals": {"$ref": "#/$defs/FarmAnimals"},
        "forage": {"$ref": "#/$defs/FarmForage"},
        "events": {"$ref": "#/$defs/FarmEvents"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["plan_version", "seed", "difficulty", "crops", "notes"],
      "additionalProperties": false
    },
    "FarmMap": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "map": {"type": "string", "minLength": 1},
        "farm_size": {"enum": ["small", "medium", "large"]},
        "plot": {"enum": ["small", "medium", "large"]},
        "animals": {"enum": ["none", "coop", "coop_and_barn"]},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "size": {"$ref": "#/$defs/Cell"},
        "house": {"$ref": "#/$defs/FarmBuilding"},
        "bin": {
          "type": "object",
          "properties": {"cell": {"$ref": "#/$defs/Cell"}, "front": {"$ref": "#/$defs/Cell"}},
          "required": ["cell"],
          "additionalProperties": false
        },
        "tillable": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "water": {
          "type": "object",
          "properties": {
            "kind": {"enum": ["pond", "well"]},
            "cells": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
            "fill": {"$ref": "#/$defs/Cell"}
          },
          "required": ["kind", "cells"],
          "additionalProperties": false
        },
        "animal_houses": {"type": "array", "items": {"$ref": "#/$defs/FarmBuilding"}},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "debris": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["branch", "stump", "grass"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "trees": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "scenery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["bush", "rock", "flowers"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "exit": {
          "type": "object",
          "properties": {
            "edge": {"enum": ["N", "E", "S", "W"]},
            "cell": {"$ref": "#/$defs/Cell"},
            "spawn": {"$ref": "#/$defs/Cell"},
            "facing": {"enum": ["up", "down", "left", "right"]},
            "to": {"type": "string"}
          },
          "required": ["edge", "cell", "spawn", "facing", "to"],
          "additionalProperties": false
        },
        "start": {
          "type": "object",
          "properties": {
            "map": {"type": "string"},
            "cell": {"$ref": "#/$defs/Cell"},
            "facing": {"enum": ["up", "down", "left", "right"]}
          },
          "required": ["map", "cell", "facing"],
          "additionalProperties": false
        },
        "added_maps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "trails": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/FarmTrail"}},
        "added": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/FarmAddedMap"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "plan_version", "seed", "id", "map", "farm_size", "plot", "animals", "difficulty", "size",
        "house", "bin", "tillable", "water", "animal_houses", "paths", "debris", "trees",
        "scenery", "exit", "start", "added_maps", "notes"
      ],
      "additionalProperties": false
    },
    "FarmTrail": {
      "type": "object",
      "properties": {
        "edge": {"enum": ["N", "E", "S", "W"]},
        "cell": {"$ref": "#/$defs/Cell"},
        "spawn": {"$ref": "#/$defs/Cell"},
        "facing": {"enum": ["up", "down", "left", "right"]}
      },
      "required": ["edge", "cell", "spawn", "facing"],
      "additionalProperties": false
    },
    "FarmAddedMap": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "index": {"type": "integer", "minimum": 1, "maximum": 8},
        "id": {"type": "string", "pattern": "^farm_map_[1-8]$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["forest", "beach", "cave"]},
        "map": {"type": "string", "pattern": "^game/maps/farm_map_[1-8]\\.tscn$"},
        "size": {"$ref": "#/$defs/Cell"},
        "ground": {"type": "string"},
        "trail": {"type": "integer", "minimum": 0, "maximum": 7},
        "door": {
          "type": "object",
          "properties": {
            "edge": {"enum": ["N", "E", "S", "W"]},
            "cell": {"$ref": "#/$defs/Cell"},
            "spawn": {"$ref": "#/$defs/Cell"},
            "facing": {"enum": ["up", "down", "left", "right"]},
            "to": {"const": "farm"}
          },
          "required": ["edge", "cell", "spawn", "facing", "to"],
          "additionalProperties": false
        },
        "clearing": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        "chambers": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4}
        },
        "walls": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "enemies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"cell": {"$ref": "#/$defs/Cell"}},
            "required": ["cell"],
            "additionalProperties": false
          }
        },
        "water": {
          "type": "object",
          "properties": {
            "kind": {"const": "sea"},
            "side": {"enum": ["N", "E", "S", "W"]},
            "cells": {"type": "array", "items": {"$ref": "#/$defs/Cell"}}
          },
          "required": ["kind", "side", "cells"],
          "additionalProperties": false
        },
        "fish": {
          "type": "object",
          "properties": {"from": {"$ref": "#/$defs/Cell"}, "at": {"$ref": "#/$defs/Cell"}},
          "required": ["from", "at"],
          "additionalProperties": false
        },
        "paths": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "trees": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "scenery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["bush", "rock", "flowers"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "debris": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"enum": ["branch", "stump", "grass"]},
              "cell": {"$ref": "#/$defs/Cell"}
            },
            "required": ["kind", "cell"],
            "additionalProperties": false
          }
        },
        "spots": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "plan_version", "seed", "index", "id", "name", "kind", "map", "size", "ground", "trail",
        "door", "paths", "trees", "scenery", "debris", "spots", "notes"
      ],
      "additionalProperties": false
    },
    "FarmBuilding": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "kind": {"enum": ["house", "coop", "barn"]},
        "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        "door": {"$ref": "#/$defs/Cell"},
        "interior": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "size": {"$ref": "#/$defs/Cell"},
            "door": {"$ref": "#/$defs/Cell"},
            "arrive": {"$ref": "#/$defs/Cell"},
            "bed": {
              "type": "object",
              "properties": {
                "cell": {"$ref": "#/$defs/Cell"},
                "size": {"$ref": "#/$defs/Cell"},
                "sleepers": {"description": "T17.26: 2 for a bed for two (two beds side by side); a bed without it sleeps one.", "enum": [1, 2]}
              },
              "required": ["cell", "size"],
              "additionalProperties": false
            },
            "start": {"$ref": "#/$defs/Cell"},
            "trough": {"$ref": "#/$defs/Cell"},
            "stalls": {"type": "array", "items": {"$ref": "#/$defs/Cell"}}
          },
          "required": ["id", "size", "door", "arrive"],
          "additionalProperties": false
        },
        "yard": {
          "type": "object",
          "properties": {
            "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
            "fence": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
            "gate": {"$ref": "#/$defs/Cell"},
            "side": {"enum": ["N", "E", "S", "W"]}
          },
          "required": ["rect", "fence"],
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "rect", "door", "interior"],
      "additionalProperties": false
    },
    "Crop": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": "string"},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "seed": {"type": "string", "minLength": 1},
        "produce": {"type": "string", "minLength": 1},
        "seasons": {
          "type": "array",
          "items": {"enum": ["spring", "summer", "autumn", "winter"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "days": {"type": "integer", "minimum": 1},
        "stages": {"type": "integer", "minimum": 1},
        "regrow": {"type": "integer", "minimum": 0},
        "seed_price": {"type": "integer", "minimum": 0},
        "price": {"type": "integer", "minimum": 0},
        "energy": {"type": "integer", "minimum": 0},
        "yield": {"type": "integer", "minimum": 1}
      },
      "required": [
        "id", "name", "seed", "produce", "seasons", "days", "stages", "regrow", "seed_price",
        "price", "energy"
      ],
      "additionalProperties": false
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": "string"},
        "home": {"type": "integer", "minimum": 1},
        "job": {"enum": ["", "shopkeeper"]},
        "pattern": {"type": "string"},
        "schedule": {
          "type": "array",
          "items": {"$ref": "#/$defs/PersonEntry"},
          "minItems": 1
        },
        "loves": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "likes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dislikes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "courtable": {"description": "T17.26: the person can be courted and married.", "type": "boolean"},
        "birthday": {
          "type": "object",
          "properties": {
            "season": {"enum": ["spring", "summer", "autumn", "winter"]},
            "day": {"type": "integer", "minimum": 1, "maximum": 28}
          },
          "required": ["season", "day"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "asset", "home", "job", "schedule", "loves", "likes", "dislikes"],
      "additionalProperties": false
    },
    "FarmEvents": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "days_per_season": {"enum": [7, 14, 28]},
        "festivals": {"type": "array", "items": {"$ref": "#/$defs/FarmEvent"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["plan_version", "seed", "days_per_season", "festivals", "notes"],
      "additionalProperties": false
    },
    "FarmEvent": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "kind": {
          "description": "What there is to do. `gathering`: nothing, the people stand on the square. `wedding` is what the game adds at run time (T17.26).",
          "enum": ["egg_hunt", "fishing_count", "produce_contest", "feast", "gathering", "wedding"]
        },
        "name": {"type": "string", "minLength": 1},
        "season": {"enum": ["spring", "summer", "autumn", "winter"]},
        "day": {"type": "integer", "minimum": 1, "maximum": 28},
        "year": {"description": "Only in this year; every year without it.", "type": "integer", "minimum": 1},
        "from": {"type": "integer", "minimum": 6, "maximum": 23},
        "to": {"type": "integer", "minimum": 7, "maximum": 24},
        "place": {"description": "The marker of the map the people gather at; each takes the spot of it their own schedule names.", "type": "string", "minLength": 1},
        "shop_closed": {"description": "False: the shop keeps its hours on this day.", "type": "boolean"},
        "table": {"description": "The marker where the judge's (or the feast's) table stands.", "type": "string", "minLength": 1},
        "spots": {"description": "The markers the eggs of an egg hunt lie at.", "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "each": {"description": "What one egg pays.", "type": "integer", "minimum": 0},
        "goal": {"description": "From how many (eggs, fish, things shipped) or from which price on the prize is won.", "type": "integer", "minimum": 1},
        "judge": {"description": "A produce contest: the dearest thing shipped that season, or how many.", "enum": ["price", "count"]},
        "points": {"description": "A feast: the friendship everybody gains.", "type": "integer", "minimum": 0},
        "prize": {
          "type": "object",
          "properties": {
            "gold": {"type": "integer", "minimum": 0},
            "item": {"type": "string", "minLength": 1},
            "qty": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "name", "season", "day"],
      "additionalProperties": false
    },
    "FarmForage": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "fishing": {"type": "boolean"},
        "forage": {"type": "array", "items": {"$ref": "#/$defs/ForageThing"}},
        "fish": {"type": "array", "items": {"$ref": "#/$defs/ForageFish"}},
        "spots": {"type": "array", "items": {"$ref": "#/$defs/Cell"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["plan_version", "seed", "fishing", "forage", "fish", "spots", "notes"],
      "additionalProperties": false
    },
    "ForageThing": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": "string"},
        "item": {"type": "string", "minLength": 1},
        "seasons": {
          "type": "array",
          "items": {"enum": ["spring", "summer", "autumn", "winter"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "price": {"type": "integer", "minimum": 0},
        "energy": {"type": "integer", "minimum": 0},
        "maps": {"type": "array", "items": {"enum": ["beach", "cave"]}, "minItems": 1, "uniqueItems": true},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
      },
      "required": ["id", "name", "asset", "item", "seasons", "price", "energy"],
      "additionalProperties": false
    },
    "ForageFish": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": "string"},
        "item": {"type": "string", "minLength": 1},
        "seasons": {
          "type": "array",
          "items": {"enum": ["spring", "summer", "autumn", "winter"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "times": {
          "type": "array",
          "items": {"enum": ["morning", "day", "evening"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "water": {"type": "array", "items": {"enum": ["pond", "sea"]}, "minItems": 1, "uniqueItems": true},
        "price": {"type": "integer", "minimum": 0},
        "energy": {"type": "integer", "minimum": 0},
        "speed": {"type": "number", "minimum": 0.25, "maximum": 4},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
      },
      "required": ["id", "name", "asset", "item", "seasons", "times", "water", "price", "energy", "speed"],
      "additionalProperties": false
    },
    "FarmAnimals": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "seed": {"type": "integer"},
        "feed": {
          "type": "object",
          "properties": {
            "item": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "price": {"type": "integer", "minimum": 0}
          },
          "required": ["item", "name", "price"],
          "additionalProperties": false
        },
        "names": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "kinds": {"type": "array", "items": {"$ref": "#/$defs/AnimalKind"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["plan_version", "seed", "feed", "names", "kinds", "notes"],
      "additionalProperties": false
    },
    "AnimalKind": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "house": {"enum": ["coop", "barn"]},
        "ticket": {"type": "string", "minLength": 1},
        "cost": {"type": "integer", "minimum": 1},
        "product": {"type": "string", "minLength": 1},
        "product_name": {"type": "string", "minLength": 1},
        "price": {"type": "integer", "minimum": 1},
        "large": {"type": "string", "minLength": 1},
        "large_price": {"type": "integer", "minimum": 1},
        "collect": {"enum": ["floor", "hand"]},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/AnimalVariant"}, "minItems": 1}
      },
      "required": [
        "id", "name", "house", "ticket", "cost", "product", "product_name", "price", "large",
        "large_price", "collect", "variants"
      ],
      "additionalProperties": false
    },
    "AnimalVariant": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "colour": {"type": "string"},
        "asset": {"type": "string"},
        "sleep": {"type": "string"}
      },
      "required": ["id", "colour", "asset", "sleep"],
      "additionalProperties": false
    },
    "PersonEntry": {
      "type": "object",
      "properties": {
        "hour": {"type": "integer", "minimum": 0, "maximum": 23},
        "days": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 6},
          "uniqueItems": true
        },
        "weather": {"type": "string"},
        "place": {"enum": ["home", "work", "square", "pond"]}
      },
      "required": ["hour", "place"],
      "additionalProperties": false
    },
    "Stages": {
      "type": "object",
      "properties": {
        "plan_version": {"const": 1},
        "kind": {"enum": ["shmup", "run_and_gun", "racing"]},
        "chunk_cols": {"type": "integer", "minimum": 1},
        "track_size": {"enum": ["small", "medium", "large"]},
        "laps": {"type": "integer", "minimum": 1},
        "block": {"type": "integer", "minimum": 1},
        "road": {"type": "integer", "minimum": 1},
        "grapple": {"type": "boolean"},
        "jump": {"type": "boolean"},
        "rows": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "orientation": {"enum": ["vertical", "horizontal"]},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "length": {"enum": ["short", "medium", "long"]},
        "view": {"$ref": "#/$defs/Cell"},
        "tile": {"type": "integer", "minimum": 8},
        "added": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "scene": {"type": "string"},
              "title": {"type": "string"},
              "level": {"type": "integer", "minimum": 0},
              "axis": {"enum": ["up", "right", "none"]},
              "speed": {"type": "number"},
              "length": {"type": "number", "minimum": 0},
              "exit": {"enum": ["reach_end", "clear_waves", "custom"]},
              "par_time_s": {"type": "number"},
              "waves": {"type": "array", "items": {"type": "object", "required": ["id", "enemy", "at"]}},
              "boss": {"type": "object"}
            },
            "required": ["id", "scene", "axis", "speed", "length", "exit", "waves"]
          }
        }
      },
      "required": ["plan_version", "orientation", "difficulty", "view", "tile", "list"],
      "additionalProperties": false
    },
    "Rooms": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
