{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpggen/config.schema.json",
  "title": "generator_config.json",
  "type": "object",
  "properties": {
    "config_version": {
      "const": 1
    },
    "generator_version": {
      "type": "string"
    },
    "godot_version": {
      "type": "string"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "archetype": {
      "enum": [
        "turn_based",
        "arpg"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackRef"
      },
      "minItems": 1
    },
    "base_tile_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 160,
        "maximum": 3840
      },
      "minItems": 2,
      "maxItems": 2
    },
    "window_size": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "map_layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "contains": {
        "const": "Ground"
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "tilesets": {
          "type": "boolean"
        },
        "collision": {
          "type": "boolean"
        },
        "terrain": {
          "type": "boolean"
        },
        "animations": {
          "type": "boolean"
        },
        "demo": {
          "type": "boolean"
        },
        "editor_tools": {
          "type": "boolean"
        },
        "save": {
          "type": "boolean"
        },
        "dialogue": {
          "type": "boolean"
        },
        "combat": {
          "type": "boolean"
        },
        "navigation": {
          "type": "boolean"
        },
        "debug_tools": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "smoke_test": {
          "type": "boolean"
        },
        "export_check": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "integer"
    },
    "sounds": {
      "type": "object",
      "properties": {
        "music_map": {"type": "string"},
        "music_battle": {"type": "string"},
        "music_title": {"type": "string"},
        "sfx_ui_move": {"type": "string"},
        "sfx_ui_confirm": {"type": "string"},
        "sfx_ui_cancel": {"type": "string"},
        "sfx_hit": {"type": "string"},
        "sfx_attack": {"type": "string"},
        "sfx_pickup": {"type": "string"},
        "sfx_chest": {"type": "string"},
        "sfx_door": {"type": "string"},
        "sfx_step": {"type": "string"},
        "sfx_save": {"type": "string"},
        "sfx_levelup": {"type": "string"}
      },
      "patternProperties": {
        "^(music|sfx)_[a-z][a-z0-9_]{1,30}$": {"type": "string"}
      },
      "additionalProperties": false
    },
    "starter_map": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "items": {"type": "integer", "minimum": 24, "maximum": 96},
          "minItems": 2,
          "maxItems": 2
        },
        "buildings": {"type": "integer", "minimum": 0, "maximum": 4},
        "npcs": {"type": "integer", "minimum": 0, "maximum": 6},
        "enemies": {"type": "integer", "minimum": 0, "maximum": 8},
        "chests": {"type": "integer", "minimum": 0, "maximum": 4},
        "decorations": {"type": "integer", "minimum": 0, "maximum": 40},
        "ground_patches": {"type": "integer", "minimum": 0, "maximum": 20},
        "ground": {"type": "string"},
        "areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "biome": {"enum": ["village", "field", "forest", "cave", "shore"]},
              "size": {
                "type": "array",
                "items": {"type": "integer", "minimum": 16, "maximum": 96},
                "minItems": 2,
                "maxItems": 2
              },
              "enemies": {"type": "integer", "minimum": 0, "maximum": 12},
              "chests": {"type": "integer", "minimum": 0, "maximum": 12},
              "join": {"type": "string"},
              "reroll": {"type": "integer", "minimum": 0}
            },
            "required": ["name", "biome"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "imported_maps": {
      "type": "object",
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "starter": {"type": "string"}
      },
      "additionalProperties": false
    },
    "repair_world": {"type": "boolean"},
    "export_targets": {
      "type": "array",
      "items": {"enum": ["windows", "web", "linux", "macos"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "git": {
      "type": "object",
      "properties": {
        "pack_art": {"enum": ["commit", "lfs", "ignore"]}
      },
      "additionalProperties": false
    },
    "starter": {
      "type": "object",
      "properties": {
        "player": {"type": "string"},
        "npc": {"type": "string"},
        "enemy": {"type": "string"},
        "ground": {"type": "string"},
        "building": {"type": "string"},
        "chest": {"type": "string"},
        "portrait": {"type": "string"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Bindings"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "config_version",
    "generator_version",
    "godot_version",
    "project_name",
    "archetype",
    "packs",
    "base_tile_size",
    "resolution",
    "window_size",
    "map_layers",
    "features",
    "validation",
    "seed",
    "input"
  ],
  "$defs": {
    "PackRef": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "zip",
            "7z",
            "rar",
            "folder"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "pack_id",
        "source",
        "source_sha256",
        "kind"
      ]
    },
    "Bindings": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "joy_buttons": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "joy_axes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "mouse_buttons": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
