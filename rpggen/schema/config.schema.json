{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpggen/config.schema.json",
  "title": "generator_config.json",
  "type": "object",
  "properties": {
    "config_version": {
      "const": 1
    },
    "generator_version": {
      "type": "string"
    },
    "godot_version": {
      "type": "string"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "archetype": {
      "enum": [
        "turn_based",
        "arpg",
        "metroidvania",
        "shmup",
        "run_and_gun",
        "racing",
        "farm"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackRef"
      },
      "minItems": 1
    },
    "base_tile_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 160,
        "maximum": 3840
      },
      "minItems": 2,
      "maxItems": 2
    },
    "window_size": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "map_layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "contains": {
        "const": "Ground"
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "tilesets": {
          "type": "boolean"
        },
        "collision": {
          "type": "boolean"
        },
        "terrain": {
          "type": "boolean"
        },
        "animations": {
          "type": "boolean"
        },
        "demo": {
          "type": "boolean"
        },
        "editor_tools": {
          "type": "boolean"
        },
        "save": {
          "type": "boolean"
        },
        "dialogue": {
          "type": "boolean"
        },
        "combat": {
          "type": "boolean"
        },
        "navigation": {
          "type": "boolean"
        },
        "debug_tools": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "smoke_test": {
          "type": "boolean"
        },
        "export_check": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "integer"
    },
    "sounds": {
      "type": "object",
      "properties": {
        "music_map": {"type": "string"},
        "music_battle": {"type": "string"},
        "music_title": {"type": "string"},
        "sfx_ui_move": {"type": "string"},
        "sfx_ui_confirm": {"type": "string"},
        "sfx_ui_cancel": {"type": "string"},
        "sfx_hit": {"type": "string"},
        "sfx_attack": {"type": "string"},
        "sfx_pickup": {"type": "string"},
        "sfx_chest": {"type": "string"},
        "sfx_door": {"type": "string"},
        "sfx_step": {"type": "string"},
        "sfx_save": {"type": "string"},
        "sfx_levelup": {"type": "string"}
      },
      "patternProperties": {
        "^(music|sfx)_[a-z][a-z0-9_]{1,30}$": {"type": "string"}
      },
      "additionalProperties": false
    },
    "starter_map": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "items": {"type": "integer", "minimum": 24, "maximum": 96},
          "minItems": 2,
          "maxItems": 2
        },
        "buildings": {"type": "integer", "minimum": 0, "maximum": 4},
        "npcs": {"type": "integer", "minimum": 0, "maximum": 6},
        "enemies": {"type": "integer", "minimum": 0, "maximum": 8},
        "chests": {"type": "integer", "minimum": 0, "maximum": 4},
        "decorations": {"type": "integer", "minimum": 0, "maximum": 40},
        "ground_patches": {"type": "integer", "minimum": 0, "maximum": 20},
        "ground": {"type": "string"},
        "orientation": {"enum": ["vertical", "horizontal"]},
        "health": {"type": "integer", "minimum": 1, "maximum": 5},
        "left_edge_kills": {"type": "boolean"},
        "keep_weapon": {"type": "boolean"},
        "grapple": {"type": "boolean"},
        "steering": {"enum": ["relative", "absolute"]},
        "camera": {"enum": ["follow", "fixed"]},
        "tracks": {"type": "integer", "minimum": 1, "maximum": 8},
        "rivals": {"type": "integer", "minimum": 0, "maximum": 5},
        "rubber_band": {"type": "boolean"},
        "elimination": {"type": "boolean"},
        "starting_money": {"type": "integer", "minimum": 0, "maximum": 99999},
        "pass_out_loss": {"type": "boolean"},
        "fishing": {"type": "boolean"},
        "days_per_season": {"enum": [7, 14, 28]},
        "day_length": {"enum": ["short", "normal", "long"]},
        "farm_size": {"enum": ["small", "medium", "large"]},
        "plot": {"enum": ["small", "medium", "large"]},
        "animals": {"enum": ["none", "coop", "coop_and_barn"]},
        "added_maps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {"name": {"type": "string", "minLength": 1}},
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "laps": {"type": "integer", "minimum": 1, "maximum": 9},
        "track_size": {"enum": ["small", "medium", "large"]},
        "added_tracks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {"name": {"type": "string", "minLength": 1}},
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "jump": {"type": "boolean"},
        "stages": {"type": "integer", "minimum": 1, "maximum": 8},
        "length": {"enum": ["short", "medium", "long"]},
        "lives": {"type": "integer", "minimum": 1, "maximum": 9},
        "bombs": {"type": "integer", "minimum": 0, "maximum": 9},
        "auto_fire": {"type": "boolean"},
        "difficulty": {"enum": ["easy", "normal", "hard"]},
        "added_stages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {"name": {"type": "string", "minLength": 1}},
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "rooms": {"type": "integer", "minimum": 5, "maximum": 12},
        "room_size": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 32, "maximum": 80},
            {"type": "integer", "minimum": 23, "maximum": 45}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "abilities": {
          "type": "array",
          "items": {"enum": ["double_jump", "dash", "wall_jump", "high_jump", "break_blocks"]},
          "uniqueItems": true,
          "maxItems": 5
        },
        "pickups": {"type": "integer", "minimum": 0, "maximum": 12},
        "added_rooms": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "join": {"type": "string"}
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "biome": {"enum": ["village", "field", "forest", "cave", "shore"]},
              "size": {
                "type": "array",
                "items": {"type": "integer", "minimum": 16, "maximum": 96},
                "minItems": 2,
                "maxItems": 2
              },
              "enemies": {"type": "integer", "minimum": 0, "maximum": 12},
              "chests": {"type": "integer", "minimum": 0, "maximum": 12},
              "join": {"type": "string"},
              "reroll": {"type": "integer", "minimum": 0}
            },
            "required": ["name", "biome"],
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["abilities", "rooms"], "properties": {"abilities": {"minItems": 3}}},
          "then": {"properties": {"rooms": {"minimum": 6}}}
        },
        {
          "if": {"required": ["abilities", "rooms"], "properties": {"abilities": {"minItems": 4}}},
          "then": {"properties": {"rooms": {"minimum": 7}}}
        },
        {
          "if": {"required": ["abilities", "rooms"], "properties": {"abilities": {"minItems": 5}}},
          "then": {"properties": {"rooms": {"minimum": 8}}}
        }
      ],
      "additionalProperties": false
    },
    "imported_maps": {
      "type": "object",
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "starter": {"type": "string"}
      },
      "additionalProperties": false
    },
    "repair_world": {"type": "boolean"},
    "projection": {"enum": ["top_down", "isometric"]},
    "iso_controls": {"enum": ["screen", "grid"]},
    "export_targets": {
      "type": "array",
      "items": {"enum": ["windows", "web", "linux", "macos"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "git": {
      "type": "object",
      "properties": {
        "pack_art": {"enum": ["commit", "lfs", "ignore"]}
      },
      "additionalProperties": false
    },
    "starter": {
      "type": "object",
      "properties": {
        "player": {"type": "string"},
        "npc": {"type": "string"},
        "enemy": {"type": "string"},
        "ground": {"type": "string"},
        "building": {"type": "string"},
        "chest": {"type": "string"},
        "portrait": {"type": "string"},
        "boss": {"type": "string"},
        "vehicle": {"type": "string"},
        "projectile": {"type": "string"},
        "explosion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Bindings"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "config_version",
    "generator_version",
    "godot_version",
    "project_name",
    "archetype",
    "packs",
    "base_tile_size",
    "resolution",
    "window_size",
    "map_layers",
    "features",
    "validation",
    "seed",
    "input"
  ],
  "$defs": {
    "PackRef": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "zip",
            "7z",
            "rar",
            "folder"
          ]
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "folders"
        ],
        "properties": {
          "kind": {
            "const": "rar"
          }
        }
      },
      "required": [
        "pack_id",
        "source",
        "source_sha256",
        "kind"
      ]
    },
    "Bindings": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "joy_buttons": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "joy_axes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "mouse_buttons": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
