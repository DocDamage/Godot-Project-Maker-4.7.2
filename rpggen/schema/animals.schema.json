{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rpggen animals of a farm (game/data/animals.json)",
  "type": "object",
  "properties": {
    "animals": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/AnimalKind"}, {"$ref": "#/$defs/Removed"}]}},
    "feed": {
      "type": "object",
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "price": {"type": "integer", "minimum": 0}
      },
      "required": ["item", "name", "price"],
      "additionalProperties": false
    },
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "houses": {"type": "array", "items": {"$ref": "#/$defs/House"}}
  },
  "required": ["animals"],
  "additionalProperties": false,
  "$defs": {
    "Removed": {
      "description": "In the user's file: this id is taken away, and the planned list does not bring it back.",
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "removed": {"const": true}
      },
      "required": ["id", "removed"],
      "additionalProperties": false
    },
    "AnimalKind": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "house": {"enum": ["coop", "barn"]},
        "ticket": {"type": "string", "minLength": 1},
        "cost": {"type": "integer", "minimum": 1},
        "product": {"type": "string", "minLength": 1},
        "product_name": {"type": "string", "minLength": 1},
        "price": {"type": "integer", "minimum": 1},
        "large": {"type": "string", "minLength": 1},
        "large_price": {"type": "integer", "minimum": 1},
        "collect": {"enum": ["floor", "hand"]},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/AnimalVariant"}, "minItems": 1}
      },
      "required": [
        "id", "name", "house", "ticket", "cost", "product", "product_name", "price", "large",
        "large_price", "collect", "variants"
      ],
      "additionalProperties": false
    },
    "AnimalVariant": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "colour": {"type": "string"},
        "asset": {"type": "string"},
        "sleep": {"type": "string"},
        "scene": {"type": "string"}
      },
      "required": ["id", "colour", "asset", "sleep"],
      "additionalProperties": false
    },
    "House": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["coop", "barn"]},
        "map": {"type": "string", "minLength": 1},
        "yard_map": {"type": "string"},
        "stalls": {"type": "integer", "minimum": 0}
      },
      "required": ["kind", "map", "stalls"],
      "additionalProperties": false
    }
  }
}
